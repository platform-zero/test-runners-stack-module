FROM debian:13-slim

ARG ANDROID_COMMAND_LINE_TOOLS=13114758
ARG APPIUM_VERSION=3.7.0
ARG UIAUTOMATOR2_VERSION=6.1.0
ARG CHROMEDRIVER_133_VERSION=133.0.6943.141

ENV DEBIAN_FRONTEND=noninteractive \
    ANDROID_HOME=/opt/android-sdk \
    ANDROID_SDK_ROOT=/opt/android-sdk \
    PATH=/opt/android-sdk/cmdline-tools/latest/bin:/opt/android-sdk/platform-tools:/opt/android-sdk/emulator:/opt/android-sdk/build-tools/36.0.0:/opt/node/bin:$PATH

RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates curl unzip xz-utils openjdk-21-jre-headless libdbus-1-3 libfontconfig1 \
      libgl1 libnss3 libpulse0 libx11-6 libxcb1 libxcomposite1 libxcursor1 \
      libxdamage1 libxext6 libxfixes3 libxi6 libxkbcommon0 libxrandr2 procps jq \
    && rm -rf /var/lib/apt/lists/* \
    && install -d /opt/android-sdk/cmdline-tools /opt/node \
    && curl -fsSLo /tmp/cmdline-tools.zip "https://dl.google.com/android/repository/commandlinetools-linux-${ANDROID_COMMAND_LINE_TOOLS}_latest.zip" \
    && unzip -q /tmp/cmdline-tools.zip -d /opt/android-sdk/cmdline-tools \
    && mv /opt/android-sdk/cmdline-tools/cmdline-tools /opt/android-sdk/cmdline-tools/latest \
    && curl -fsSL https://nodejs.org/dist/v22.19.0/node-v22.19.0-linux-x64.tar.xz | tar -xJ --strip-components=1 -C /opt/node \
    && yes | sdkmanager --licenses >/dev/null \
    && sdkmanager "platform-tools" "emulator" \
      "platforms;android-34" "system-images;android-34;google_apis;x86_64" \
      "platforms;android-36" "system-images;android-36;google_apis;x86_64" "build-tools;36.0.0" \
    && npm install -g "appium@${APPIUM_VERSION}" \
    && appium driver install "uiautomator2@${UIAUTOMATOR2_VERSION}" \
    && curl -fsSLo /tmp/chromedriver-133.zip \
      "https://storage.googleapis.com/chrome-for-testing-public/${CHROMEDRIVER_133_VERSION}/linux64/chromedriver-linux64.zip" \
    && unzip -q /tmp/chromedriver-133.zip -d /tmp/chromedriver-133 \
    && install -d /opt/chromedrivers \
    && install -m 0755 /tmp/chromedriver-133/chromedriver-linux64/chromedriver \
      /opt/chromedrivers/chromedriver-133 \
    && rm -rf /tmp/chromedriver-133 /tmp/chromedriver-133.zip \
    && rm -f /tmp/cmdline-tools.zip \
    && useradd --create-home --uid 1000 --shell /bin/bash android \
    && chown -R android:android /opt/android-sdk /opt/node /home/android

RUN apt-get update && apt-get install -y --no-install-recommends libglib2.0-0t64 \
    && rm -rf /var/lib/apt/lists/*

RUN curl -fsSLo /tmp/chromedriver-113.zip \
      https://chromedriver.storage.googleapis.com/113.0.5672.63/chromedriver_linux64.zip \
    && unzip -q /tmp/chromedriver-113.zip -d /tmp/chromedriver-113 \
    && install -m 0755 /tmp/chromedriver-113/chromedriver \
      /opt/chromedrivers/chromedriver-113 \
    && rm -rf /tmp/chromedriver-113 /tmp/chromedriver-113.zip

COPY stack.containers/android-test-runner/android-apks.lock.json /usr/local/share/android-apks.lock.json
COPY stack.containers/android-test-runner/fetch-apks.sh /usr/local/bin/fetch-android-apks
RUN chmod 0755 /usr/local/bin/fetch-android-apks

COPY stack.containers/android-test-runner/entrypoint.sh /usr/local/bin/android-test-entrypoint
COPY stack.containers/android-test-runner/run-android-tests.sh /usr/local/bin/run-android-tests
COPY stack.containers/android-test-runner/mail-proxy.js /usr/local/lib/android-mail-proxy.js
COPY stack.containers/android-test-runner/dns-proxy.js /usr/local/lib/android-dns-proxy.js
RUN chmod 0755 / /usr/local/bin/android-test-entrypoint /usr/local/bin/run-android-tests

WORKDIR /home/android
ENTRYPOINT ["/usr/local/bin/android-test-entrypoint"]
